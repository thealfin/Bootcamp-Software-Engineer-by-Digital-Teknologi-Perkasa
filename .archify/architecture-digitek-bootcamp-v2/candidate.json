  "cards": [
    {
      "dot": "cyan",
      "title": "Frontend Features (src/features/*)",
      "items": [
        "src/router.tsx & src/entry-server.tsx: SSR prefetch + TanStack Router routes",
        "src/features/landing/*: LandingPage, Navbar, AuthModal (password + login), MentorProfilePage",
        "src/features/slides/*: Fullscreen GSAP SlidePlayer, 8 SlideLayouts, GateSlide & TaskSlide",
        "src/features/admin/*: AdminLayout, AdminLoginPage, Overview, Review, Participants, Materials CRUD, Analytics"
      ]
    },
    {
      "dot": "rose",
      "title": "Security & Progressive Unlock",
      "items": [
        "src/lib/session.ts: scryptSync + 16B salt + timingSafeEqual passwords, HMAC-SHA256 HttpOnly cookie",
        "src/lib/access-guard.ts: Guest SUMMARY_ONLY (P01-P15), P00/P16 open, progressive unlock on Mentor ACC",
        "server.ts: requireMentor RBAC guard (403) on all /api/admin/* & /api/mentor/* endpoints"
      ]
    },
    {
      "dot": "emerald",
      "title": "Persistence & Dual Repository",
      "items": [
        "src/db/schema.ts: PostgreSQL tables users, modules, slides, task_submissions, module_unlocks",
        "src/db/repository.ts: NeonDrizzleRepository (primary) with automatic LocalJsonRepository fallback",
        "src/db/seed/*: P00-P16 modules & slides seeded idempotently on startup"
      ]
    }
  ]

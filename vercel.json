{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/api-entry.js": {
      "includeFiles": "{dist/server/**,dist/client/index.html}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/api-entry.js"
    },
    {
      "source": "/((?!assets/|favicon\\.svg|logo\\.png).*)",
      "destination": "/api/api-entry.js"
    }
  ]
}
